{
	"name": "maria-api",
	"author": "Luis Neira",
	"repository": {
		"type": "git"
	},
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.23.0"
	},
	"imports": {
		"#db/*": "./src/db/*",
		"#src/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file=.env --env-file-if-exists=.env.local --watch src/server.ts | pino-pretty",
		"start": "node src/server.ts",
		"test": "borp",
		"test:watch": "borp --watch",
		"test:coverage": "borp --coverage --check-coverage --lines 95 --functions 95 --branches 95 --statements 95",
		"test:unit": "borp --pattern \"test/unit/**/*.test.ts\"",
		"test:integration": "borp --pattern \"test/integration/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"db:serve": "pglite-server --db=./data/pgdata --port=54329 --max-connections=10",
		"db:migrate": "node --env-file=.env node_modules/.bin/pg-migrations apply -D db/migrations",
		"db:seed": "set -a && . ./.env && set +a && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 --single-transaction -q -f db/seed.sql",
		"db:reset": "set -a && . ./.env && set +a && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -c \"SET client_min_messages = warning; DROP SCHEMA public CASCADE; CREATE SCHEMA public;\" && npm run db:migrate && npm run db:seed",
		"db:types": "kysely-codegen --env-file .env --dialect postgres --camel-case --out-file src/db/db.d.ts --exclude-pattern \"public.atdatabases_*\""
	},
	"dependencies": {
		"@databases/pg-migrations": "6.0.0",
		"close-with-grace": "^2.5.0",
		"fastify": "5.12.8",
		"fastify-plugin": "6.0.1",
		"kysely": "0.29.9",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@electric-sql/pglite": "0.6.0",
		"@electric-sql/pglite-socket": "0.3.0",
		"@tsconfig/node-ts": "^23.6.5",
		"@tsconfig/node22": "^22.0.7",
		"@types/node": "22.20.5",
		"@types/pg": "8.23.1",
		"borp": "1.0.1",
		"kysely-codegen": "0.20.0",
		"pino-pretty": "13.2.0",
		"typescript": "7.0.2"
	},
	"license": "MIT"
}
